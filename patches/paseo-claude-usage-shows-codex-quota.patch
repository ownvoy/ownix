+// through the "claude" provider) can prefix their model id this way to have
+// the tooltip show the backing service's quota instead of (or in addition
+// to) the declared provider's.
+const USAGE_PROVIDER_ID_OVERRIDES: Array<{ prefix: string; usageProviderId: string }> = [
+  { prefix: "claude-ocx-native--", usageProviderId: "codex" },
+];
+
+export function resolveUsageProviderId(
+  activeProviderId: string | null | undefined,
+  activeModelId: string | null | undefined,
+): string | null {
+  if (activeModelId) {
+    const override = USAGE_PROVIDER_ID_OVERRIDES.find((entry) =>
+      activeModelId.startsWith(entry.prefix),
+    );
+    if (override) return override.usageProviderId;
+  }
+  return activeProviderId ?? null;
+}
